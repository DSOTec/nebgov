# NebGov App Environment Variables
# Copy this file to .env.local and update with your contract addresses

# Governor contract address on Stellar
NEXT_PUBLIC_GOVERNOR_ADDRESS=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM

# Timelock contract address on Stellar
NEXT_PUBLIC_TIMELOCK_ADDRESS=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM

# Token Votes contract address on Stellar
NEXT_PUBLIC_VOTES_ADDRESS=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM

# Optional: independent conviction-voting contract address
# NEXT_PUBLIC_CONVICTION_VOTING_ADDRESS=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM

# Optional: Co-sponsorship registry contract address (enables draft/co-sponsor flows)
# NEXT_PUBLIC_CO_SPONSORSHIP_ADDRESS=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM

# Optional: Gasless-signaling result anchor contract address (enables AnchorVerifiedBadge)
# NEXT_PUBLIC_SIGNAL_ANCHOR_ADDRESS=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM

# Optional: Treasury yield-strategy allocator contract address (enables /treasury/strategies)
# NEXT_PUBLIC_TREASURY_STRATEGIES_ADDRESS=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM

# Optional: Optimistic-governance track contract address (enables /optimistic)
# NEXT_PUBLIC_OPTIMISTIC_GOVERNOR_ADDRESS=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM

# Optional: Indexer base URL (enables strategies listing + performance history)
# NEXT_PUBLIC_INDEXER_URL=http://localhost:3001

# Stellar network: mainnet, testnet, or futurenet
NEXT_PUBLIC_NETWORK=testnet

# Optional: Backend API base URL for persisted notifications
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Optional: Custom RPC URL (defaults to public endpoint if not set)
# NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

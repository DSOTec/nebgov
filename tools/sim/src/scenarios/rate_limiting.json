{
  "name": "rate_limiting",
  "description": "Validates proposal cooldown and max-proposals-per-period enforcement",
  "seed": 2,
  "governor_settings": {
    "voting_delay": 1,
    "voting_period": 5,
    "quorum_numerator": 10,
    "proposal_threshold": 100,
    "vote_type": "Extended",
    "proposal_grace_period": 1000,
    "max_calldata_size": 10000,
    "proposal_cooldown": 50,
    "max_proposals_per_period": 2,
    "proposal_period_duration": 10000
  },
  "actors": [
    { "name": "alice", "initial_balance": 1000, "delegate_to": null, "role": "Proposer" }
  ],
  "steps": [
    { "type": "Propose", "actor": "alice", "targets": ["target"], "fn_names": ["noop"], "description": "first proposal" },
    { "type": "Propose", "actor": "alice", "targets": ["target"], "fn_names": ["noop"], "description": "immediate second proposal, should hit cooldown" },
    { "type": "ExpectError", "step_index": 1, "expected_error": "Error(Contract, #6)" },
    { "type": "AdvanceLedger", "ledgers": 60 },
    { "type": "Propose", "actor": "alice", "targets": ["target"], "fn_names": ["noop"], "description": "second proposal after cooldown elapses" },
    { "type": "AdvanceLedger", "ledgers": 60 },
    { "type": "Propose", "actor": "alice", "targets": ["target"], "fn_names": ["noop"], "description": "third proposal, should hit max-per-period" },
    { "type": "ExpectError", "step_index": 6, "expected_error": "Error(Contract, #6)" }
  ]
}

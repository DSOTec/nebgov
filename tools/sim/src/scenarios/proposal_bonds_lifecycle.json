{
  "name": "proposal_bonds_lifecycle",
  "description": "Exercises proposal bond locking, correlation with governor proposals, terminal-state refund, and slashing through an executed governance proposal",
  "seed": 1090,
  "governor_settings": {
    "voting_delay": 1,
    "voting_period": 5,
    "quorum_numerator": 10,
    "proposal_threshold": 100,
    "vote_type": "Extended",
    "proposal_grace_period": 1000,
    "max_calldata_size": 10000,
    "proposal_cooldown": 0,
    "max_proposals_per_period": 5,
    "proposal_period_duration": 10000
  },
  "actors": [
    { "name": "alice", "initial_balance": 1000, "delegate_to": null, "role": "Proposer" },
    { "name": "bob", "initial_balance": 1000, "delegate_to": null, "role": "Proposer" },
    { "name": "treasury", "initial_balance": 0, "delegate_to": null, "role": "TokenHolder" }
  ],
  "steps": [
    { "type": "LockProposalBond", "actor": "alice", "description": "Fund the public-goods grant" },
    { "type": "ExpectBondState", "description": "Fund the public-goods grant", "expected_state": "Locked" },
    { "type": "Propose", "actor": "alice", "targets": ["target"], "fn_names": ["noop"], "description": "Fund the public-goods grant" },
    { "type": "AdvanceLedger", "ledgers": 2 },
    { "type": "Vote", "actor": "alice", "proposal_id": 1, "support": "For" },
    { "type": "Vote", "actor": "bob", "proposal_id": 1, "support": "For" },
    { "type": "AdvanceLedger", "ledgers": 5 },
    { "type": "Queue", "actor": "alice", "proposal_id": 1 },
    { "type": "AdvanceLedger", "ledgers": 1 },
    { "type": "Execute", "actor": "alice", "proposal_id": 1 },
    { "type": "ExpectState", "proposal_id": 1, "expected_state": "Executed" },
    { "type": "AdvanceLedger", "ledgers": 2 },
    { "type": "RefundProposalBond", "actor": "bob", "description": "Fund the public-goods grant", "proposal_id": 1 },
    { "type": "ExpectBondState", "description": "Fund the public-goods grant", "expected_state": "Refunded" },

    { "type": "LockProposalBond", "actor": "alice", "description": "Malicious duplicate proposal" },
    { "type": "Propose", "actor": "alice", "targets": ["target"], "fn_names": ["noop"], "description": "Malicious duplicate proposal" },
    { "type": "ProposeBondSlash", "actor": "bob", "bonded_description": "Malicious duplicate proposal", "recipient": "treasury", "description": "Slash the malicious proposal bond" },
    { "type": "AdvanceLedger", "ledgers": 2 },
    { "type": "Vote", "actor": "alice", "proposal_id": 2, "support": "Against" },
    { "type": "Vote", "actor": "alice", "proposal_id": 3, "support": "For" },
    { "type": "Vote", "actor": "bob", "proposal_id": 3, "support": "For" },
    { "type": "AdvanceLedger", "ledgers": 5 },
    { "type": "ExpectState", "proposal_id": 2, "expected_state": "Defeated" },
    { "type": "Queue", "actor": "bob", "proposal_id": 3 },
    { "type": "AdvanceLedger", "ledgers": 1 },
    { "type": "Execute", "actor": "bob", "proposal_id": 3 },
    { "type": "ExpectState", "proposal_id": 3, "expected_state": "Executed" },
    { "type": "ExpectBondState", "description": "Malicious duplicate proposal", "expected_state": "Slashed" },
    { "type": "TakeAnalyticsSnapshot" }
  ]
}

{
  "name": "quadratic_voting",
  "description": "Validates quadratic vote weighting (weight = sqrt(balance)) compresses an extreme balance gap between two actors",
  "seed": 4,
  "governor_settings": {
    "voting_delay": 1,
    "voting_period": 10,
    "quorum_numerator": 0,
    "proposal_threshold": 0,
    "vote_type": "Quadratic",
    "proposal_grace_period": 1000,
    "max_calldata_size": 10000,
    "proposal_cooldown": 0,
    "max_proposals_per_period": 5,
    "proposal_period_duration": 10000
  },
  "actors": [
    { "name": "whale", "initial_balance": 1000000, "delegate_to": null, "role": "Proposer" },
    { "name": "minnow", "initial_balance": 100, "delegate_to": null, "role": "TokenHolder" }
  ],
  "steps": [
    { "type": "Propose", "actor": "whale", "targets": ["target"], "fn_names": ["noop"], "description": "quadratic weighting test" },
    { "type": "AdvanceLedger", "ledgers": 2 },
    { "type": "Vote", "actor": "whale", "proposal_id": 1, "support": "For" },
    { "type": "Vote", "actor": "minnow", "proposal_id": 1, "support": "Against" },
    { "type": "AdvanceLedger", "ledgers": 10 },
    { "type": "ExpectState", "proposal_id": 1, "expected_state": "Succeeded" },
    { "type": "TakeAnalyticsSnapshot" }
  ]
}

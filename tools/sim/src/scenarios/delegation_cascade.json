{
  "name": "delegation_cascade",
  "description": "Exercises delegation chains and re-delegation. Note: token-votes delegation is not transitive — delegate() moves only the caller's own token balance to the new delegatee, so redelegating a downstream node does not carry upstream delegators' power with it. This scenario demonstrates that explicitly.",
  "seed": 5,
  "governor_settings": {
    "voting_delay": 1,
    "voting_period": 10,
    "quorum_numerator": 5,
    "proposal_threshold": 50,
    "vote_type": "Extended",
    "proposal_grace_period": 1000,
    "max_calldata_size": 10000,
    "proposal_cooldown": 0,
    "max_proposals_per_period": 5,
    "proposal_period_duration": 10000
  },
  "actors": [
    { "name": "alice", "initial_balance": 300, "delegate_to": "bob", "role": "TokenHolder" },
    { "name": "bob", "initial_balance": 200, "delegate_to": "carol", "role": "TokenHolder" },
    { "name": "carol", "initial_balance": 100, "delegate_to": null, "role": "Proposer" }
  ],
  "steps": [
    { "type": "Propose", "actor": "carol", "targets": ["target"], "fn_names": ["noop"], "description": "cascade check before re-delegation" },
    { "type": "AdvanceLedger", "ledgers": 2 },
    { "type": "Vote", "actor": "carol", "proposal_id": 1, "support": "For" },
    { "type": "AdvanceLedger", "ledgers": 10 },
    { "type": "ExpectState", "proposal_id": 1, "expected_state": "Succeeded" },
    { "type": "Delegate", "actor": "bob", "delegatee": "alice" },
    { "type": "Delegate", "actor": "carol", "delegatee": "alice" },
    { "type": "TakeAnalyticsSnapshot" }
  ]
}

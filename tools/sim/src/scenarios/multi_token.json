{
  "name": "multi_token",
  "description": "NOTE: the governor's MultiToken voting strategy (contracts/governor/src/lib.rs, set_voting_strategy) is not yet expressible via this tool's SimStep schema, which matches the issue's spec and has no SetVotingStrategy step — the runner always wires up the default Single-token strategy. This scenario instead exercises the lifecycle with several independent token holders to approximate the spirit of a multi-constituency vote, and is a placeholder for a future SetVotingStrategy step.",
  "seed": 7,
  "governor_settings": {
    "voting_delay": 1,
    "voting_period": 10,
    "quorum_numerator": 10,
    "proposal_threshold": 50,
    "vote_type": "Extended",
    "proposal_grace_period": 1000,
    "max_calldata_size": 10000,
    "proposal_cooldown": 0,
    "max_proposals_per_period": 5,
    "proposal_period_duration": 10000
  },
  "actors": [
    { "name": "alice", "initial_balance": 400, "delegate_to": null, "role": "Proposer" },
    { "name": "bob", "initial_balance": 300, "delegate_to": null, "role": "TokenHolder" },
    { "name": "carol", "initial_balance": 300, "delegate_to": null, "role": "TokenHolder" }
  ],
  "steps": [
    { "type": "Propose", "actor": "alice", "targets": ["target"], "fn_names": ["noop"], "description": "multi-constituency approximation" },
    { "type": "AdvanceLedger", "ledgers": 2 },
    { "type": "Vote", "actor": "alice", "proposal_id": 1, "support": "For" },
    { "type": "Vote", "actor": "bob", "proposal_id": 1, "support": "For" },
    { "type": "Vote", "actor": "carol", "proposal_id": 1, "support": "Against" },
    { "type": "AdvanceLedger", "ledgers": 10 },
    { "type": "AssertParticipation", "proposal_id": 1, "min_bps": 9000 },
    { "type": "ExpectState", "proposal_id": 1, "expected_state": "Succeeded" }
  ]
}

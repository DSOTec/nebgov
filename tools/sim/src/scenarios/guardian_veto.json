{
  "name": "guardian_veto",
  "description": "Guardian cancels a proposal while it is Active; a second proposal shows the guardian cannot cancel once voting has already succeeded and moved past Active",
  "seed": 3,
  "governor_settings": {
    "voting_delay": 1,
    "voting_period": 10,
    "quorum_numerator": 10,
    "proposal_threshold": 100,
    "vote_type": "Extended",
    "proposal_grace_period": 1000,
    "max_calldata_size": 10000,
    "proposal_cooldown": 0,
    "max_proposals_per_period": 5,
    "proposal_period_duration": 10000
  },
  "actors": [
    { "name": "alice", "initial_balance": 1000, "delegate_to": null, "role": "Proposer" },
    { "name": "gary", "initial_balance": 0, "delegate_to": null, "role": "Guardian" }
  ],
  "steps": [
    { "type": "Propose", "actor": "alice", "targets": ["target"], "fn_names": ["noop"], "description": "proposal the guardian will veto" },
    { "type": "AdvanceLedger", "ledgers": 2 },
    { "type": "ExpectState", "proposal_id": 1, "expected_state": "Active" },
    { "type": "Cancel", "actor": "gary", "proposal_id": 1 },
    { "type": "ExpectState", "proposal_id": 1, "expected_state": "Cancelled" },
    { "type": "Propose", "actor": "alice", "targets": ["target"], "fn_names": ["noop"], "description": "proposal the guardian is too late to veto" },
    { "type": "AdvanceLedger", "ledgers": 2 },
    { "type": "Vote", "actor": "alice", "proposal_id": 2, "support": "For" },
    { "type": "AdvanceLedger", "ledgers": 10 },
    { "type": "ExpectState", "proposal_id": 2, "expected_state": "Succeeded" },
    { "type": "Cancel", "actor": "gary", "proposal_id": 2 },
    { "type": "ExpectError", "step_index": 10, "expected_error": "Error(Contract, #1)" }
  ]
}

{
  "name": "large_governance",
  "description": "Scaled down from the issue's illustrative '50 actors, 200 proposals' figure to keep CI runtime reasonable (each Propose/Vote/Queue/Execute step is a real cross-contract call chain) — see scripts/simulate.ts's generateRandomScenario() to generate a full-scale version for local stress testing.",
  "seed": 9,
  "governor_settings": {
    "voting_delay": 1,
    "voting_period": 10,
    "quorum_numerator": 10,
    "proposal_threshold": 50,
    "vote_type": "Extended",
    "proposal_grace_period": 1000,
    "max_calldata_size": 10000,
    "proposal_cooldown": 0,
    "max_proposals_per_period": 20,
    "proposal_period_duration": 10000
  },
  "actors": [
    { "name": "a0", "initial_balance": 500, "delegate_to": null, "role": "Proposer" },
    { "name": "a1", "initial_balance": 300, "delegate_to": null, "role": "TokenHolder" },
    { "name": "a2", "initial_balance": 300, "delegate_to": null, "role": "TokenHolder" },
    { "name": "a3", "initial_balance": 200, "delegate_to": null, "role": "TokenHolder" },
    { "name": "a4", "initial_balance": 200, "delegate_to": null, "role": "TokenHolder" },
    { "name": "a5", "initial_balance": 150, "delegate_to": "a0", "role": "TokenHolder" },
    { "name": "a6", "initial_balance": 150, "delegate_to": "a1", "role": "TokenHolder" },
    { "name": "a7", "initial_balance": 100, "delegate_to": null, "role": "TokenHolder" },
    { "name": "a8", "initial_balance": 100, "delegate_to": null, "role": "TokenHolder" },
    { "name": "a9", "initial_balance": 100, "delegate_to": null, "role": "TokenHolder" }
  ],
  "steps": [
    { "type": "Propose", "actor": "a0", "targets": ["target"], "fn_names": ["noop"], "description": "proposal 1" },
    { "type": "AdvanceLedger", "ledgers": 2 },
    { "type": "Vote", "actor": "a0", "proposal_id": 1, "support": "For" },
    { "type": "Vote", "actor": "a1", "proposal_id": 1, "support": "For" },
    { "type": "Vote", "actor": "a2", "proposal_id": 1, "support": "Against" },
    { "type": "Vote", "actor": "a3", "proposal_id": 1, "support": "Abstain" },
    { "type": "AdvanceLedger", "ledgers": 10 },
    { "type": "ExpectState", "proposal_id": 1, "expected_state": "Succeeded" },
    { "type": "Propose", "actor": "a0", "targets": ["target"], "fn_names": ["noop"], "description": "proposal 2" },
    { "type": "AdvanceLedger", "ledgers": 2 },
    { "type": "Vote", "actor": "a1", "proposal_id": 2, "support": "Against" },
    { "type": "Vote", "actor": "a2", "proposal_id": 2, "support": "Against" },
    { "type": "Vote", "actor": "a3", "proposal_id": 2, "support": "For" },
    { "type": "AdvanceLedger", "ledgers": 10 },
    { "type": "ExpectState", "proposal_id": 2, "expected_state": "Defeated" },
    { "type": "Propose", "actor": "a0", "targets": ["target"], "fn_names": ["noop"], "description": "proposal 3" },
    { "type": "AdvanceLedger", "ledgers": 2 },
    { "type": "Vote", "actor": "a4", "proposal_id": 3, "support": "For" },
    { "type": "Vote", "actor": "a7", "proposal_id": 3, "support": "For" },
    { "type": "Vote", "actor": "a8", "proposal_id": 3, "support": "For" },
    { "type": "Vote", "actor": "a9", "proposal_id": 3, "support": "Abstain" },
    { "type": "AdvanceLedger", "ledgers": 10 },
    { "type": "ExpectState", "proposal_id": 3, "expected_state": "Succeeded" },
    { "type": "Queue", "actor": "a0", "proposal_id": 3 },
    { "type": "AdvanceLedger", "ledgers": 1 },
    { "type": "Execute", "actor": "a0", "proposal_id": 3 },
    { "type": "ExpectState", "proposal_id": 3, "expected_state": "Executed" },
    { "type": "TakeAnalyticsSnapshot" }
  ]
}

{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "NebGov Backend API",
    "description": "REST API for NebGov backend services"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "adminSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "ADMIN_SECRET"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Something went wrong"
          }
        },
        "required": [
          "error"
        ]
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ]
            }
          }
        },
        "required": [
          "errors"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "wallet_address": {
            "type": "string",
            "minLength": 10,
            "maxLength": 56,
            "example": "GABC123...XYZ"
          }
        },
        "required": [
          "wallet_address"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "user_id": {
            "type": "number"
          },
          "wallet_address": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "user_id",
          "wallet_address"
        ]
      },
      "RefreshResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "LeaderboardEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "user_id": {
            "type": "number"
          },
          "score": {
            "type": "number"
          },
          "rank": {
            "type": "number"
          },
          "snapshot_date": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "wallet_address": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "user_id",
          "score",
          "rank",
          "snapshot_date",
          "created_at",
          "wallet_address"
        ]
      },
      "LeaderboardHistoryResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LeaderboardEntry"
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "total": {
                "type": "number"
              },
              "limit": {
                "type": "number"
              },
              "offset": {
                "type": "number"
              },
              "hasMore": {
                "type": "boolean"
              }
            },
            "required": [
              "total",
              "limit",
              "offset",
              "hasMore"
            ]
          }
        },
        "required": [
          "data",
          "pagination"
        ]
      },
      "Competition": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "entry_fee": {
            "type": "number"
          },
          "start_date": {
            "type": "string"
          },
          "end_date": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean"
          },
          "created_by": {
            "type": "number",
            "nullable": true
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "participant_count": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "entry_fee",
          "start_date",
          "end_date",
          "is_active",
          "created_at",
          "updated_at"
        ]
      },
      "CompetitionParticipant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "competition_id": {
            "type": "number"
          },
          "user_id": {
            "type": "number"
          },
          "entry_fee_paid": {
            "type": "number"
          },
          "joined_at": {
            "type": "string"
          },
          "wallet_address": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "competition_id",
          "user_id",
          "entry_fee_paid",
          "joined_at"
        ]
      },
      "CreateCompetitionRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "entry_fee": {
            "type": "integer",
            "nullable": true,
            "minimum": 0
          },
          "start_date": {
            "type": "string",
            "format": "date-time"
          },
          "end_date": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "name",
          "entry_fee",
          "start_date",
          "end_date"
        ]
      },
      "UpdateCompetitionRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "entry_fee": {
            "type": "integer",
            "nullable": true,
            "minimum": 0
          },
          "start_date": {
            "type": "string",
            "format": "date-time"
          },
          "end_date": {
            "type": "string",
            "format": "date-time"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "NotificationPreferences": {
        "type": "object",
        "properties": {
          "created_self": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          },
          "voting_ends_soon": {
            "type": "boolean"
          },
          "outcome": {
            "type": "boolean"
          },
          "queued": {
            "type": "boolean"
          },
          "executed": {
            "type": "boolean"
          }
        },
        "required": [
          "created_self",
          "active",
          "voting_ends_soon",
          "outcome",
          "queued",
          "executed"
        ]
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "type": {
            "type": "string"
          },
          "proposal_id": {
            "type": "number",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "read": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "read",
          "created_at"
        ]
      },
      "CreateNotificationRequest": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "proposal_id": {
            "type": "integer",
            "nullable": true,
            "minimum": 0
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ]
      },
      "MarkReadRequest": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "nullable": true
            }
          },
          "all": {
            "type": "boolean"
          }
        }
      },
      "WebhookSubscriptionRequest": {
        "type": "object",
        "properties": {
          "callback_url": {
            "type": "string",
            "format": "uri"
          },
          "event_filter": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "default": []
          }
        },
        "required": [
          "callback_url"
        ]
      },
      "WebhookSubscriptionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "callback_url": {
            "type": "string"
          },
          "event_filter": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "active": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "callback_url",
          "event_filter",
          "active",
          "created_at"
        ]
      },
      "PartialNotificationPreferences": {
        "type": "object",
        "properties": {
          "created_self": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          },
          "voting_ends_soon": {
            "type": "boolean"
          },
          "outcome": {
            "type": "boolean"
          },
          "queued": {
            "type": "boolean"
          },
          "executed": {
            "type": "boolean"
          }
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Authenticate with wallet address (creates the user if new)",
        "description": "Logs a wallet in. Returns a short-lived access token and sets a httpOnly refresh-token cookie.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Exchange a refresh-token cookie for a new access token",
        "description": "Rotates the refresh token and issues a new short-lived access token.",
        "responses": {
          "200": {
            "description": "Token refreshed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Invalidate the current refresh token",
        "responses": {
          "200": {
            "description": "Logged out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/leaderboard/history": {
      "get": {
        "tags": [
          "Leaderboard"
        ],
        "summary": "Get historical leaderboard rankings",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "nullable": true,
              "format": "date-time",
              "description": "Filter by snapshot date"
            },
            "required": false,
            "description": "Filter by snapshot date",
            "name": "date",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "nullable": true
            },
            "required": false,
            "name": "user_id",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "nullable": true,
              "minimum": 0,
              "default": 0
            },
            "required": false,
            "name": "offset",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated leaderboard history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaderboardHistoryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/competitions": {
      "get": {
        "tags": [
          "Competitions"
        ],
        "summary": "List competitions with pagination",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "required": false,
            "name": "is_active",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "nullable": true,
              "minimum": 0,
              "default": 0
            },
            "required": false,
            "name": "offset",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of competitions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "competitions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Competition"
                      }
                    },
                    "total": {
                      "type": "number"
                    },
                    "limit": {
                      "type": "number"
                    },
                    "offset": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "competitions",
                    "total",
                    "limit",
                    "offset"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Competitions"
        ],
        "summary": "Create a competition (admin only)",
        "security": [
          {
            "adminSecret": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCompetitionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Competition created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "competition": {
                      "$ref": "#/components/schemas/Competition"
                    }
                  },
                  "required": [
                    "competition"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "403": {
            "description": "Admin authorization required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/competitions/{id}": {
      "get": {
        "tags": [
          "Competitions"
        ],
        "summary": "Get a single competition",
        "security": [
          {
            "bearerAuth": []
          },
          {}
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMinimum": true
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Competition details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "competition": {
                      "$ref": "#/components/schemas/Competition"
                    },
                    "is_joined": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "competition"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Competition not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Competitions"
        ],
        "summary": "Update a competition (admin only, before start_date)",
        "security": [
          {
            "adminSecret": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMinimum": true
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCompetitionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Competition updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "competition": {
                      "$ref": "#/components/schemas/Competition"
                    }
                  },
                  "required": [
                    "competition"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, or competition already started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "403": {
            "description": "Admin authorization required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Competition not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Competitions"
        ],
        "summary": "Soft-delete a competition (admin only, no participants)",
        "security": [
          {
            "adminSecret": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMinimum": true
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Competition deactivated"
          },
          "400": {
            "description": "Competition has existing participants",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Admin authorization required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Competition not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/competitions/{id}/participants": {
      "get": {
        "tags": [
          "Competitions"
        ],
        "summary": "List participants in a competition",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMinimum": true
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "nullable": true,
              "minimum": 0,
              "default": 0
            },
            "required": false,
            "name": "offset",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
